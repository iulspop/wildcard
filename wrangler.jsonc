{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wildcard",
  "main": "worker.ts",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOMS",
        "class_name": "GameRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"],
    },
  ],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "wildcard-auth",
      "database_id": "5cf1044c-890e-477d-8b25-411c515b4037",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "PASSKEY_RP_ID": "wildcard.polyanova.workers.dev",
    "PASSKEY_RP_NAME": "Wildcard",
    "PASSKEY_ORIGIN": "https://wildcard.polyanova.workers.dev",
    "TEMPORARY_ROOM_TTL_MS": "3600000",
  },
  "env": {
    "preview": {
      "name": "wildcard-preview",
      "durable_objects": {
        "bindings": [
          {
            "name": "GAME_ROOMS",
            "class_name": "GameRoom",
          },
        ],
      },
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "wildcard-auth-preview",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "PASSKEY_RP_ID": "preview.wildcard.example",
        "PASSKEY_RP_NAME": "Wildcard Preview",
        "PASSKEY_ORIGIN": "https://preview.wildcard.example",
        "TEMPORARY_ROOM_TTL_MS": "3600000",
      },
    },
  },
}
